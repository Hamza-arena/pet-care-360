# PetCare 360 Environment Configuration Example
# Copy this file to .env and configure your local variables. Do NOT commit .env to source control.

# Flask Application Mode ('development', 'testing', 'production')
FLASK_ENV=development

# Secret key for session signing and CSRF protection
# In production, use a strong random secret (e.g. generated via `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev-insecure-secret-key-change-in-prod

# Database Connection URL
# SQLite for local dev: sqlite:///petcare360_dev.db
# PostgreSQL for production/staging: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///petcare360_dev.db

# Server Port
PORT=5000

